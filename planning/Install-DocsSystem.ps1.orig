#!/usr/bin/env pwsh

<#
.SYNOPSIS
    Installs the Docusaurus-Template documentation system into a project,
    fetching the template on demand.

.DESCRIPTION
    A bootstrap wrapper around the template's own scripts/setup-docs.ps1. Drop
    this single file into any repository and run it; it fetches the template,
    delegates the actual install, and cleans up after itself.

    It deliberately does not reimplement the install. Everything -- which files
    are written, idempotency, -WhatIf reporting, path validation -- comes from
    setup-docs.ps1 in the fetched template, so this script cannot drift away
    from what the template actually does.

    Fetch order:
      1. -TemplateDir, if given: use an existing local checkout, fetch nothing.
      2. git clone --depth 1, if git is on PATH.
      3. GitHub tarball via Invoke-WebRequest + tar, if the repository URL is a
         GitHub one.

    The target project should be a git repository. The installed documentation
    gate locates the repository root by walking up for a .git marker, so it
    fails with a clear error in a directory that was never git init'd.

.PARAMETER ProjectDir
    Project to install into. Defaults to the current directory. Created if it
    does not exist.

.PARAMETER Ref
    Template branch, tag, or commit to install from. Defaults to 'main'.

.PARAMETER RepositoryUrl
    Template repository. Defaults to the public Docusaurus-Template.

.PARAMETER TemplateDir
    Use this existing template checkout instead of fetching. Useful offline, in
    CI that already has the template, or when testing template changes.

.PARAMETER Title
    Homepage front matter title. Defaults to the project directory name.

.PARAMETER Description
    Homepage front matter description.

.PARAMETER SiteUrl
    Published site origin, with a trailing slash. Absolute links to it in the
    README are rewritten to '/' in the generated homepage, so one README works
    both on the code host and as the site homepage.

.PARAMETER ScriptDir
    Where PowerShell tooling is installed, relative to the project. Default 'build'.

.PARAMETER ConfigDir
    Where the gate rules are installed, relative to the project. Default '.config'.

.PARAMETER NoHomepage
    Do not generate the homepage from the README, and do not drift-check it.

.PARAMETER SkipWorkflow
    Install no GitHub Actions workflows.

.PARAMETER SkipGate
    Install no documentation gate.

.PARAMETER Overwrite
    Replace files that already exist. Without it, existing files are skipped,
    which is what makes re-running safe for picking up template updates.

.EXAMPLE
    ./Install-DocsSystem.ps1

    Install into the current directory from the template's main branch.

.EXAMPLE
    ./Install-DocsSystem.ps1 -Title 'My Project' -SiteUrl 'https://docs.example.com/'

.EXAMPLE
    ./Install-DocsSystem.ps1 -WhatIf

    Report every file that would be written, without writing any. The template
    is still fetched, since that is what makes the report accurate.

.EXAMPLE
    ./Install-DocsSystem.ps1 -Overwrite

    Re-run after a template update, replacing the files the template owns.

.EXAMPLE
    ./Install-DocsSystem.ps1 -TemplateDir ../Docusaurus-Template -Ref (ignored)

    Install from a local checkout without any network access.
#>

[CmdletBinding(SupportsShouldProcess)]
param(
    [Parameter()][string]$ProjectDir = '.',
    [Parameter()][string]$Ref = 'main',
    [Parameter()][string]$RepositoryUrl = 'https://github.com/The-Running-Dev/Docusaurus-Template.git',
    [Parameter()][string]$TemplateDir,
    [Parameter()][string]$Title,
    [Parameter()][string]$Description = '',
    [Parameter()][string]$SiteUrl = '',
    [Parameter()][string]$ScriptDir = 'build',
    [Parameter()][string]$ConfigDir = '.config',
    [Parameter()][switch]$NoHomepage,
    [Parameter()][switch]$SkipWorkflow,
    [Parameter()][switch]$SkipGate,
    [Parameter()][switch]$Overwrite
)

Set-StrictMode -Version 3.0
$ErrorActionPreference = 'Stop'

function Write-Step {
    param([Parameter(Mandatory)][string]$Message)
    Write-Host "[INSTALL-DOCS] $Message" -ForegroundColor Cyan
}

function Remove-TemporaryTree {
    <#
    .SYNOPSIS
    Deletes a fetched tree, tolerating git's read-only objects on Windows.

    A failure to clean up a temp directory must never fail an install that
    already succeeded, so this warns rather than throws.
    #>
    param([Parameter(Mandatory)][string]$Path)

    if (-not (Test-Path -LiteralPath $Path)) { return }

    try {
        Get-ChildItem -LiteralPath $Path -Recurse -Force -File -ErrorAction SilentlyContinue |
            ForEach-Object { $_.Attributes = 'Normal' }
        Remove-Item -LiteralPath $Path -Recurse -Force -ErrorAction Stop
    }
    catch {
        Write-Warning "Could not remove temporary directory '$Path': $($_.Exception.Message)"
    }
}

function Get-GitHubTarballUri {
    <#
    .SYNOPSIS
    Maps a GitHub repository URL and ref to its codeload tarball, or $null when
    the URL is not a GitHub one.
    #>
    param(
        [Parameter(Mandatory)][string]$Url,
        [Parameter(Mandatory)][string]$Reference
    )

    $match = [regex]::Match($Url, '^https?://(?:www\.)?github\.com/(?<owner>[^/]+)/(?<repo>[^/]+?)(?:\.git)?/?$')
    if (-not $match.Success) { return $null }

    return "https://codeload.github.com/$($match.Groups['owner'].Value)/$($match.Groups['repo'].Value)/tar.gz/$Reference"
}

function Get-Template {
    <#
    .SYNOPSIS
    Fetches the template into a new temporary directory and returns its path.
    #>
    param(
        [Parameter(Mandatory)][string]$Url,
        [Parameter(Mandatory)][string]$Reference
    )

    $temp = Join-Path ([IO.Path]::GetTempPath()) ("docs-template-" + [Guid]::NewGuid().ToString('N').Substring(0, 12))
    New-Item -ItemType Directory -Path $temp -Force | Out-Null

    if (Get-Command git -ErrorAction SilentlyContinue) {
        Write-Step "Cloning $Url @ $Reference ..."
        # --depth 1 keeps this fast; the template's history is irrelevant here.
        & git clone --quiet --depth 1 --branch $Reference $Url $temp 2>&1 | Out-Null
        if ($LASTEXITCODE -eq 0) { return $temp }

        Remove-TemporaryTree -Path $temp
        throw "git clone failed for '$Url' at ref '$Reference'. Check the ref exists and the repository is reachable."
    }

    $tarball = Get-GitHubTarballUri -Url $Url -Reference $Reference
    if (-not $tarball) {
        Remove-TemporaryTree -Path $temp
        throw "git was not found on PATH and '$Url' is not a GitHub URL. Install git, or pass -TemplateDir with a local checkout."
    }
    if (-not (Get-Command tar -ErrorAction SilentlyContinue)) {
        Remove-TemporaryTree -Path $temp
        throw 'Neither git nor tar was found on PATH. Install one of them, or pass -TemplateDir with a local checkout.'
    }

    Write-Step "Downloading $tarball ..."
    $archive = Join-Path $temp 'template.tar.gz'
    try {
        Invoke-WebRequest -Uri $tarball -OutFile $archive -UseBasicParsing
    }
    catch {
        Remove-TemporaryTree -Path $temp
        throw "Download failed for '$tarball': $($_.Exception.Message)"
    }

    & tar -xzf $archive -C $temp
    if ($LASTEXITCODE -ne 0) {
        Remove-TemporaryTree -Path $temp
        throw "tar failed to extract '$archive'."
    }
    Remove-Item -LiteralPath $archive -Force

    # A GitHub tarball wraps everything in a single <repo>-<ref> directory.
    $extracted = @(Get-ChildItem -LiteralPath $temp -Directory)
    if ($extracted.Count -ne 1) {
        Remove-TemporaryTree -Path $temp
        throw "Unexpected tarball layout: expected exactly one top-level directory, found $($extracted.Count)."
    }

    return $extracted[0].FullName
}

# --- Resolve the template ----------------------------------------------------

$fetchedRoot = $null

try {
    if ($PSBoundParameters.ContainsKey('TemplateDir') -and -not [string]::IsNullOrWhiteSpace($TemplateDir)) {
        if (-not (Test-Path -LiteralPath $TemplateDir -PathType Container)) {
            throw "TemplateDir '$TemplateDir' does not exist or is not a directory."
        }
        $templateRoot = (Resolve-Path -LiteralPath $TemplateDir).Path
        Write-Step "Using local template checkout: $templateRoot"
    }
    else {
        $templateRoot = Get-Template -Url $RepositoryUrl -Reference $Ref
        $fetchedRoot = $templateRoot
    }

    $installer = Join-Path $templateRoot 'scripts/setup-docs.ps1'
    if (-not (Test-Path -LiteralPath $installer -PathType Leaf)) {
        throw "Template installer not found at '$installer'. The ref '$Ref' may predate it, or -TemplateDir may not point at a template checkout."
    }

    # --- Delegate the install ------------------------------------------------

    # Passed through rather than reimplemented, so this wrapper stays thin and
    # the template remains the single source of truth for what gets installed.
    $arguments = @{
        ProjectDir   = $ProjectDir
        Description  = $Description
        SiteUrl      = $SiteUrl
        ScriptDir    = $ScriptDir
        ConfigDir    = $ConfigDir
        NoHomepage   = $NoHomepage
        SkipWorkflow = $SkipWorkflow
        SkipGate     = $SkipGate
        Overwrite    = $Overwrite
        WhatIf       = [bool]$WhatIfPreference
    }
    if ($PSBoundParameters.ContainsKey('Title')) {
        $arguments['Title'] = $Title
    }

    Write-Step "Installing into '$ProjectDir' ..."
    Write-Host ''
    & $installer @arguments

    Write-Host ''
    if ($WhatIfPreference) {
        Write-Step 'Dry run complete. Nothing was written; re-run without -WhatIf to install.'
    }
    else {
        Write-Step 'Done.'
        Write-Host '               Commit the installed files, then make the docs checks required' -ForegroundColor DarkGray
        Write-Host '               so a red run blocks a merge.' -ForegroundColor DarkGray
    }
}
finally {
    if ($fetchedRoot) {
        # The tarball path returns a subdirectory of the temp root, so climb to
        # whichever ancestor lives directly under the system temp directory.
        $tempRoot = [IO.Path]::GetFullPath([IO.Path]::GetTempPath()).TrimEnd('\', '/')
        $cleanup = [IO.Path]::GetFullPath($fetchedRoot)
        while ($true) {
            $parent = Split-Path -Parent $cleanup
            if ([string]::IsNullOrEmpty($parent) -or $parent -eq $cleanup) { break }
            if ([IO.Path]::GetFullPath($parent).TrimEnd('\', '/') -eq $tempRoot) { break }
            $cleanup = $parent
        }
        Remove-TemporaryTree -Path $cleanup
    }
}
