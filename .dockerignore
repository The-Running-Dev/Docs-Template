# =============================================================================
# DOCUSAURUS TEMPLATE - DOCKER IGNORE
# =============================================================================

# =============================================================================
# NODE.JS / NPM / PNPM / YARN
# =============================================================================

# Dependency directories
#
# The `**/` prefix is load-bearing: Docker matches .dockerignore patterns
# against the full context-relative path, so a bare `node_modules/` excludes
# only the root one. Without these, `api/node_modules` (~160MB of pnpm store)
# is sent as build context and BuildKit fails on the symlinks inside
# `.pnpm/` with "invalid file request".
node_modules/
**/node_modules/
jspm_packages/
**/jspm_packages/
.pnpm-store/
**/.pnpm-store/
web_modules/
**/web_modules/

# Package manager files
.npm
.yarn-integrity
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Package outputs
*.tgz

# =============================================================================
# LOGS AND DIAGNOSTICS
# =============================================================================

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Optional REPL history
.node_repl_history

# TernJS port file
.tern-port

# =============================================================================
# BUILD OUTPUTS AND CACHES
# =============================================================================

# General cache directories
.cache
.parcel-cache
.temp
.fusebox/

# Build outputs (same `**/` reasoning as node_modules above — `api/dist` and
# `api/coverage` both exist and would otherwise be sent)
build/
**/build/
dist/
**/dist/
out/
**/out/
artifacts/
**/artifacts/

# ...except the generated PowerShell module, which the image embeds at
# /PSModule for Install-PSModule to retrieve. It is build output like the rest
# of artifacts/, so it is not committed, but it has to reach the build context.
# scripts/build-psmodule.ps1 produces it; run that before docker build.
!artifacts/PSModule
!artifacts/PSModule/**

# Coverage and testing
coverage/
**/coverage/
*.lcov
.nyc_output
**/.nyc_output
lib-cov

# TypeScript cache
*.tsbuildinfo

# Tool-specific caches
.eslintcache
.stylelintcache
.grunt

# Legacy build tools
bower_components/
.lock-wscript
build/Release

# =============================================================================
# FRAMEWORK-SPECIFIC
# =============================================================================

# Docusaurus
.docusaurus/
**/.docusaurus/

# Next.js
.next/

# Nuxt.js
.nuxt/
dist/

# Gatsby
.cache/
# Uncomment if using Gatsby instead of Next.js
# public/

# Vue/Vite
.vitepress/dist/
.vitepress/cache/
.svelte-kit/

# VuePress
.vuepress/dist/

# Vite logs
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# =============================================================================
# ENVIRONMENT AND CONFIGURATION
# =============================================================================

# Environment variables
.env
.env.*
!.env.example

# Build configuration
.build/
.build.env

# =============================================================================
# PROJECT-SPECIFIC (DOCUSAURUS TEMPLATE)
# =============================================================================

# Auto-generated files
data/*.json
src/**/*.js
scripts/**/*.js
static/CNAME

# Build scripts
set-environment.ps1

# =============================================================================
# DEVELOPMENT AND TOOLING
# =============================================================================

# IDE
.vscode/
.vscode-test/
vscode.code-workspace

# Cloud services
.serverless/
.firebase/
.dynamodb/

# Version Control
.git/
.github/

# =============================================================================
# EXCLUDE FROM DOCKER BUILD
# =============================================================================

# Documentation and meta files
README.md
CHANGELOG.md
LICENSE
*.md

# Configuration files not needed in container
.prettierrc
.prettierignore
.gitignore
.dockerignore
eslint.config.js
vitest.config.ts
tsconfig.json

.nuke/
.husky/

Dockerfile
data/

# The template's own docs are not shipped to consumers either: a consumer
# overlays their own docs/ onto /template, and anything left here would be
# sample content they inherit. Excluded rather than copied and then deleted in
# the Dockerfile, so it never enters the build context at all.
docs/

# The template's own pages are not shipped to consumers. Docusaurus compiles
# everything under src/pages into routes, and those routes come from the image's
# siteDir rather than the mounted content, so a consumer cannot suppress them:
# every consumer site was inheriting /, /cv, /portfolio, /projects and
# /admin/projects, wearing the consumer's own title. index.tsx was the damaging
# one, since it claimed the site root and left no supported way to replace it.
#
# Excluded from the image only. The files stay in the repository, where this
# template's own site is built from and still serves them, and where the
# components behind them keep their tests.
src/pages/